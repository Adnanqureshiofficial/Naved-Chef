# Dependency folders (Never push these; they are too large)
node_modules/
jspm_packages/
web_modules/

# Local environment variables (Contains secret API keys/passwords)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build and distribution folders (Generated automatically from source)
dist/
build/
out/

# Log files (Generated during errors or runtime)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.log

# Operating system files (Hidden system junk)
.DS_Store
Thumbs.db

# Editor-specific configurations
.vscode/
.idea/
*.suo
*.ntvs*
