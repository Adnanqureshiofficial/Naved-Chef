---
import BaseLayout from '../../layouts/BaseLayout.astro';

import DishHero from '../../components/dish/DishHero.astro';
import DishStory from '../../components/dish/DishStory.astro';
import DishGallery from '../../components/dish/DishGallery.astro';
import DishNavigation from '../../components/dish/DishNavigation.astro';
import DishBackLink from '../../components/dish/DishBackLink.astro';

import { getCollection, render } from 'astro:content';

const categoryLabels: Record<string, string> = {
  'plated-dessert': 'Plated Dessert',
  'cake-entremet': 'Cake & Entremet',
  'chocolate-showpieces': 'Chocolate Showpieces',
  'viennoiserie': 'Viennoiserie',
};

export async function getStaticPaths() {
  const dishes = await getCollection('dishes');

  return dishes.map((dish) => ({
    params: {
      dish: dish.id,
    },
    props: {
      dish,
    },
  }));
}

const { dish } = Astro.props;

const { Content } = await render(dish);

const categoryLabel =
  categoryLabels[dish.data.category] ?? dish.data.category;


/*
 * Find previous / next creation
 * within the same category.
 */
const allDishes = await getCollection('dishes');

const categoryDishes = allDishes
  .filter(
    (item) =>
      item.data.category === dish.data.category
  )
  .sort(
    (a, b) =>
      a.data.order - b.data.order
  );

const currentIndex = categoryDishes.findIndex(
  (item) => item.id === dish.id
);

const previousDish =
  categoryDishes.length > 1
    ? categoryDishes[
        currentIndex > 0
          ? currentIndex - 1
          : categoryDishes.length - 1
      ]
    : undefined;

const nextDish =
  categoryDishes.length > 1
    ? categoryDishes[
        currentIndex < categoryDishes.length - 1
          ? currentIndex + 1
          : 0
      ]
    : undefined;
---

<BaseLayout
  title={`${dish.data.title} — ${categoryLabel}`}
  description={dish.data.flavorNote}
>

  <main class="dish-page">

    <DishBackLink />

    <DishHero
      title={dish.data.title}
      category={categoryLabel}
      flavorNote={dish.data.flavorNote}
      heroImage={dish.data.heroImage}
      year={dish.data.year}
    />

    <DishStory Content={Content} />

    {dish.data.gallery.length > 0 && (
      <DishGallery
        images={dish.data.gallery}
        title={dish.data.title}
      />
    )}

    <DishNavigation
      previous={
        previousDish
          ? {
              id: previousDish.id,
              title: previousDish.data.title,
              image: previousDish.data.heroImage,
              href: `/creations/${previousDish.id}`,
            }
          : undefined
      }
      next={
        nextDish
          ? {
              id: nextDish.id,
              title: nextDish.data.title,
              image: nextDish.data.heroImage,
              href: `/creations/${nextDish.id}`
            }
          : undefined
      }
    />

  </main>

</BaseLayout>

<style>
  .dish-page {
    width: min(100%, 1600px);
    margin: 0 auto;
    padding: 2rem clamp(1rem, 3vw, 3rem) 0;
  }

  @media (max-width: 700px) {
    .dish-page {
      padding: 1rem 0 0;
    }

    .dish-page > :global(.dish-back) {
      margin-left: 1rem;
    }
  }
</style>