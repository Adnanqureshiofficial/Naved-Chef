---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allDishes = (await getCollection('dishes'))
  .sort((a, b) => a.data.order - b.data.order);

const categories = [
  {
    slug: 'plated-dessert',
    label: 'Plated Dessert'
  },
  {
    slug: 'cake-entremet',
    label: 'Cake & Entremet'
  },
  {
    slug: 'chocolate-showpieces',
    label: 'Chocolate Showpieces'
  },
  {
    slug: 'viennoiserie',
    label: 'Viennoiserie'
  }
];

const categoryCounts = categories.map((category) => ({
  ...category,
  count: allDishes.filter(
    (dish) => dish.data.category === category.slug
  ).length
}));

const categoryLabel = (slug: string) =>
  categories.find((category) => category.slug === slug)?.label ?? slug;
---

<BaseLayout
  title="Creations — [Chef Full Name]"
  description="Explore a collection of pastry, chocolate, cake, entremet and viennoiserie creations shaped by technique, flavour and contemporary presentation."
>

  <section class="creations">

    <!-- =====================================================
         INTRODUCTION
         ===================================================== -->

    <header class="creations__intro container">

      <div class="creations__intro-top reveal">

        <p class="eyebrow">
          Creations
        </p>

        <span class="creations__intro-line"></span>

        <span class="creations__intro-meta">
          Pastry · Chocolate · Bakery
        </span>

      </div>


      <div class="creations__intro-main">

        <div class="creations__intro-heading reveal">

          <h1 class="font-display">
            Crafted with
            <em>passion.</em>
          </h1>

        </div>


        <div class="creations__intro-copy reveal">

          <p>
            A collection of pastry, chocolate and bakery creations developed
            through professional kitchen experience, thoughtful flavour
            combinations and a passion for refined presentation.
          </p>

        </div>

      </div>


      <!-- =================================================
           CATEGORY FILTER
           ================================================= -->

      <nav
        class="creations__filters reveal"
        aria-label="Filter creations by category"
        role="tablist"
      >

        <button
          class="filter-btn is-active"
          data-filter="all"
          role="tab"
          aria-selected="true"
        >
          <span class="filter-btn__label">All Creations</span>

          <span class="filter-btn__count">
            {String(allDishes.length).padStart(2, '0')}
          </span>
        </button>


        {categoryCounts.map((category) => (

          <button
            class="filter-btn"
            data-filter={category.slug}
            role="tab"
            aria-selected="false"
          >

            <span class="filter-btn__label">
              {category.label}
            </span>

            <span class="filter-btn__count">
              {String(category.count).padStart(2, '0')}
            </span>

          </button>

        ))}

      </nav>

    </header>


    <!-- =====================================================
         CREATIONS GRID
         ===================================================== -->

    <section
      class="creations__archive container"
      aria-label="Chef's creations"
    >

      <div
        class="creations__grid"
        id="creations-grid"
      >

        {allDishes.map((dish, index) => (

          <a
            href={`/creations/${dish.id}`}
            class:list={[
              'dish-tile',
              'reveal',
              {
                /*
                 * Maintain the original 12-column system:
                 * regular = 4 columns
                 * large   = 6 columns
                 *
                 * The pattern is made more deliberate so
                 * the visual rhythm feels less random.
                 */
                'dish-tile--large':
                  index === 0 ||
                  index === 5 ||
                  index === 10
              }
            ]}
            data-category={dish.data.category}
          >

            <div class="dish-tile__image">

              <img
                src={dish.data.heroImage}
                alt={dish.data.title}
                loading="lazy"
              />

              <span
                class="dish-tile__view"
                aria-hidden="true"
              >
                ↗
              </span>

            </div>


            <div class="dish-tile__details">

              <div class="dish-tile__meta">

                <span>
                  {categoryLabel(dish.data.category)}
                </span>

                {dish.data.year && (
                  <span>
                    {dish.data.year}
                  </span>
                )}

              </div>


              <div class="dish-tile__title-row">

                <h2 class="font-display">
                  {dish.data.title}
                </h2>

                <span
                  class="dish-tile__arrow"
                  aria-hidden="true"
                >
                  ↗
                </span>

              </div>

            </div>

          </a>

        ))}

      </div>


      <p
        class="creations__empty"
        id="creations-empty"
        hidden
      >
        No creations found in this category.
      </p>

    </section>

  </section>

</BaseLayout>


<script>

  const buttons =
    document.querySelectorAll<HTMLButtonElement>(
      '.filter-btn'
    );

  const tiles =
    document.querySelectorAll<HTMLElement>(
      '.dish-tile'
    );

  const emptyState =
    document.getElementById(
      'creations-empty'
    );


  buttons.forEach((button) => {

    button.addEventListener(
      'click',
      () => {

        const filter =
          button.dataset.filter ?? 'all';


        /* ---------------------------------------------
           Update active filter
        --------------------------------------------- */

        buttons.forEach((item) => {

          item.classList.remove(
            'is-active'
          );

          item.setAttribute(
            'aria-selected',
            'false'
          );

        });


        button.classList.add(
          'is-active'
        );

        button.setAttribute(
          'aria-selected',
          'true'
        );


        /* ---------------------------------------------
           Filter creations
        --------------------------------------------- */

        let visibleCount = 0;


        tiles.forEach((tile) => {

          const matches =
            filter === 'all' ||
            tile.dataset.category === filter;


          tile.hidden = !matches;


          if (matches) {
            visibleCount++;
          }

        });


        /* ---------------------------------------------
           Empty state
        --------------------------------------------- */

        if (emptyState) {

          emptyState.hidden =
            visibleCount !== 0;

        }

      }
    );

  });

</script>


<style>

  /* =====================================================
     PAGE
     ===================================================== */

  .creations {
    padding-top: 140px;
    padding-bottom: 140px;
  }


  /* =====================================================
     INTRO
     ===================================================== */

  .creations__intro {
    margin-bottom: 100px;
  }


  .creations__intro-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
  }


  .creations__intro-line {
    height: 1px;
    background: var(--color-border);
  }


  .creations__intro-meta {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.5px;
    line-height: 1;
    text-transform: uppercase;
  }


  .creations__intro-main {
    display: grid;
    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(260px, 0.65fr);

    gap: clamp(40px, 10vw, 160px);

    align-items: end;

    margin-top: 48px;
  }


  .creations__intro-heading h1 {
    max-width: 850px;

    margin: 0;

    font-size:
      clamp(72px, 11vw, 170px);

    font-weight: 400;

    line-height: 0.78;

    letter-spacing: -0.045em;
  }


  .creations__intro-heading h1 em {
    display: block;

    padding-left:
      clamp(30px, 8vw, 130px);

    color: var(--color-accent);

    font-style: italic;
  }


  .creations__intro-copy {
    max-width: 360px;

    padding-bottom: 6px;
  }


  .creations__intro-copy p {
    margin: 0;

    color: var(--color-text-muted);

    font-family: var(--font-body);

    font-size: 13px;

    line-height: 1.85;
  }


  /* =====================================================
     CATEGORY FILTER
     ===================================================== */

  .creations__filters {

    display: flex;
    align-items: stretch;

    width: 100%;

    margin-top: 72px;

    overflow-x: auto;

    scrollbar-width: none;

    border-top:
      1px solid
      var(--color-border);

    border-bottom:
      1px solid
      var(--color-border);

  }


  .creations__filters::-webkit-scrollbar {
    display: none;
  }


  .filter-btn {

    position: relative;

    flex:
      1 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;

    min-height: 62px;

    padding:
      0 24px;

    border: 0;

    border-right:
      1px solid
      var(--color-border);

    background: transparent;

    color:
      var(--color-text-muted);

    font: inherit;

    text-align: left;

    cursor: pointer;

    white-space: nowrap;

    transition:
      color 0.3s var(--ease-luxury),
      background 0.35s var(--ease-luxury);
  }


  .filter-btn:first-child {
    padding-left: 0;
  }


  .filter-btn:last-child {
    border-right: 0;
  }


  .filter-btn::after {

    content: "";

    position: absolute;

    left: 0;
    bottom: -1px;

    width: 0;
    height: 2px;

    background:
      var(--color-accent);

    transition:
      width 0.45s var(--ease-luxury);
  }


  .filter-btn__label {

    font-family:
      var(--font-display);

    font-size: 21px;

    font-weight: 400;

    line-height: 1;

    transition:
      transform 0.35s var(--ease-luxury);
  }


  .filter-btn__count {

    color:
      rgba(249, 246, 240, 0.35);

    font-family:
      var(--font-body);

    font-size: 8px;

    font-weight: 600;

    letter-spacing: 1.3px;
  }


  .filter-btn:hover,
  .filter-btn.is-active {

    color:
      var(--color-accent);

  }


  .filter-btn:hover::after,
  .filter-btn.is-active::after {

    width: 100%;

  }


  .filter-btn:hover
  .filter-btn__label {

    transform:
      translateX(4px);

  }


  .filter-btn.is-active
  .filter-btn__count {

    color:
      rgba(200, 169, 107, 0.75);

  }


  /* =====================================================
     CREATIONS GRID
     ===================================================== */

  .creations__archive {
    margin-top: 0;
  }


  .creations__grid {

    display: grid;

    grid-template-columns:
      repeat(12, minmax(0, 1fr));

    gap:
      clamp(28px, 4vw, 64px)
      clamp(16px, 2vw, 32px);

    margin-top: 72px;

    /*
     * Keeps the existing 12-column layout while allowing
     * suitable tiles to fill available grid space.
     */
    grid-auto-flow: dense;
  }


  /* =====================================================
     DISH TILE
     ===================================================== */

  .dish-tile {

    grid-column:
      span 4;

    display: block;

    min-width: 0;

    color: inherit;

    text-decoration: none;

    transition:
      opacity 0.35s ease;
  }


  .dish-tile--large {

    grid-column:
      span 6;

  }


  .dish-tile__image {

    position: relative;

    overflow: hidden;

    aspect-ratio:
      4 / 5;

    background:
      var(--color-surface);
  }


  .dish-tile--large
  .dish-tile__image {

    aspect-ratio:
      4 / 4.6;

  }


  .dish-tile__image img {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition:
      transform 0.9s var(--ease-luxury);

  }


  .dish-tile:hover
  .dish-tile__image img {

    transform:
      scale(1.035);

  }


  .dish-tile__image::after {

    content: "";

    position: absolute;

    inset: 0;

    background:
      rgba(20, 18, 16, 0.2);

    opacity: 0;

    transition:
      opacity 0.5s var(--ease-luxury);

  }


  .dish-tile:hover
  .dish-tile__image::after {

    opacity: 1;

  }


  /* =====================================================
     VIEW AFFORDANCE
     ===================================================== */

  .dish-tile__view {

    position: absolute;

    right: 16px;
    bottom: 16px;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 38px;
    height: 38px;

    border:
      1px solid
      rgba(249, 246, 240, 0.55);

    color:
      var(--color-text);

    font-size: 15px;

    opacity: 0;

    transform:
      translateY(8px);

    transition:
      opacity 0.4s var(--ease-luxury),
      transform 0.4s var(--ease-luxury);
  }


  .dish-tile:hover
  .dish-tile__view {

    opacity: 1;

    transform:
      translateY(0);

  }


  /* =====================================================
     TILE DETAILS
     ===================================================== */

  .dish-tile__details {

    padding-top: 15px;

  }


  .dish-tile__meta {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size: 7px;

    font-weight: 600;

    letter-spacing: 1.3px;

    text-transform: uppercase;
  }


  .dish-tile__meta span:first-child {

    color:
      rgba(249, 246, 240, 0.55);

  }


  .dish-tile__title-row {

    display: flex;

    align-items: baseline;

    justify-content: space-between;

    gap: 16px;

    margin-top: 8px;

  }


  .dish-tile h2 {

    margin: 0;

    color:
      var(--color-text);

    font-size:
      clamp(23px, 2.5vw, 34px);

    font-weight: 400;

    line-height: 0.95;

    letter-spacing: -0.02em;

    transition:
      color 0.3s var(--ease-luxury);

  }


  .dish-tile:hover h2 {

    color:
      var(--color-accent);

  }


  .dish-tile__arrow {

    flex-shrink: 0;

    color:
      var(--color-accent);

    font-size: 17px;

    opacity: 0;

    transform:
      translate(-4px, 4px);

    transition:
      opacity 0.35s var(--ease-luxury),
      transform 0.35s var(--ease-luxury);

  }


  .dish-tile:hover
  .dish-tile__arrow {

    opacity: 1;

    transform:
      translate(0, 0);

  }


  /* =====================================================
     EMPTY STATE
     ===================================================== */

  .creations__empty {

    padding:
      60px 0;

    border-bottom:
      1px solid
      var(--color-border);

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size: 12px;

  }


  /* =====================================================
     REVEAL
     ===================================================== */

  .reveal {

    opacity: 0;

    transform:
      translateY(24px);

    animation:
      creationReveal
      0.9s
      var(--ease-luxury)
      forwards;

  }


  .creations__grid
  .reveal:nth-child(2) {

    animation-delay:
      0.08s;

  }


  .creations__grid
  .reveal:nth-child(3) {

    animation-delay:
      0.14s;

  }


  .creations__grid
  .reveal:nth-child(4) {

    animation-delay:
      0.20s;

  }


  .creations__grid
  .reveal:nth-child(5) {

    animation-delay:
      0.26s;

  }


  .creations__grid
  .reveal:nth-child(6) {

    animation-delay:
      0.32s;

  }


  @keyframes creationReveal {

    to {

      opacity: 1;

      transform:
        translateY(0);

    }

  }


  /* =====================================================
     TABLET
     ===================================================== */

  @media (max-width: 900px) {

    .creations {

      padding-top:
        120px;

    }


    .creations__intro-main {

      grid-template-columns:
        1fr;

      gap:
        42px;

    }


    .creations__intro-copy {

      max-width:
        420px;

      margin-left:
        auto;

    }


    .creations__filters {

      margin-top:
        60px;

    }


    .filter-btn {

      flex:
        0 0 auto;

      padding:
        0 22px;

    }


    .filter-btn:first-child {

      padding-left:
        0;

    }


    .dish-tile,
    .dish-tile--large {

      grid-column:
        span 6;

    }

  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 640px) {

    .creations {

      padding-top:
        110px;

      padding-bottom:
        90px;

    }


    .creations__intro {

      margin-bottom:
        0;

    }


    .creations__intro-top {

      grid-template-columns:
        auto 1fr;

    }


    .creations__intro-meta {

      display:
        none;

    }


    .creations__intro-main {

      margin-top:
        38px;

      gap:
        34px;

    }


    .creations__intro-heading h1 {

      font-size:
        clamp(64px, 19vw, 100px);

      line-height:
        0.82;

    }


    .creations__intro-heading h1 em {

      padding-left:
        10vw;

    }


    .creations__intro-copy {

      margin-left:
        0;

    }


    /*
     * Horizontal category navigation
     */

    .creations__filters {

      width:
        calc(100% + 40px);

      margin-left:
        -20px;

      margin-top:
        46px;

      overflow-x:
        auto;

      border-top:
        1px solid
        var(--color-border);

      border-bottom:
        1px solid
        var(--color-border);

    }


    .filter-btn {

      min-height:
        54px;

      padding:
        0 18px;

      border-right:
        0;

      gap:
        9px;

    }


    .filter-btn:first-child {

      padding-left:
        20px;

    }


    .filter-btn:last-child {

      padding-right:
        20px;

    }


    .filter-btn__label {

      font-size:
        20px;

      white-space:
        nowrap;

    }


    .filter-btn__count {

      font-size:
        7px;

    }


    .creations__grid {

      grid-template-columns:
        1fr;

      gap:
        54px;

      margin-top:
        48px;

      grid-auto-flow:
        row;

    }


    .dish-tile,
    .dish-tile--large {

      grid-column:
        auto;

    }


    .dish-tile__image,
    .dish-tile--large
    .dish-tile__image {

      aspect-ratio:
        4 / 5;

    }


    /*
     * Always show the interaction affordance
     * on touch devices.
     */

    .dish-tile__view {

      opacity:
        1;

      transform:
        none;

    }


    .dish-tile__arrow {

      opacity:
        1;

      transform:
        none;

    }


    .dish-tile h2 {

      font-size:
        29px;

    }

  }


  /* =====================================================
     SMALL PHONES
     ===================================================== */

  @media (max-width: 380px) {

    .creations {

      padding-top:
        96px;

    }


    .creations__intro-heading h1 {

      font-size:
        61px;

    }


    .dish-tile h2 {

      font-size:
        26px;

    }

  }


  /* =====================================================
     ACCESSIBILITY
     ===================================================== */

  .filter-btn:focus-visible,
  .dish-tile:focus-visible {

    outline:
      2px solid
      var(--color-accent);

    outline-offset:
      5px;

  }


  /* =====================================================
     REDUCED MOTION
     ===================================================== */

  @media (prefers-reduced-motion: reduce) {

    .reveal {

      opacity:
        1;

      transform:
        none;

      animation:
        none;

    }


    .dish-tile__image img,
    .filter-btn,
    .dish-tile,
    .dish-tile__arrow {

      transition:
        none !important;

    }

  }

</style>