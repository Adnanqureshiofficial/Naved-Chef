---
import { getCollection } from 'astro:content';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

function formatRange(start: string, end: string | undefined, current: boolean) {
  const fmt = (d: string) => {
    const [y, m] = d.split('-');
    return new Date(Number(y), Number(m) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  };
  return `${fmt(start)} — ${current ? 'Present' : end ? fmt(end) : ''}`;
}
---
<section class="experience" id="experience">
  <div class="container">
    <p class="eyebrow">Career</p>
    <h2>Experience</h2>

    <ol class="timeline">
      {entries.map((entry) => (
        <li class="timeline__item">
          <div class="timeline__meta">
            <span class="timeline__range">{formatRange(entry.data.startDate, entry.data.endDate, entry.data.current)}</span>
          </div>
          <div class="timeline__body card">
            <h3>{entry.data.role}</h3>
            <p class="timeline__property">{entry.data.property}{entry.data.location ? `, ${entry.data.location}` : ''}</p>
            <p class="timeline__summary">{entry.data.summary}</p>
            {entry.data.highlights.length > 0 && (
              <ul class="timeline__highlights">
                {entry.data.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    {entries.length === 0 && (
      <p class="timeline__empty">
        <!-- TODO: add entries as markdown files in src/content/experience/ -->
        No experience entries yet — add .md files to src/content/experience/.
      </p>
    )}
  </div>
</section>

<style>
  .experience { padding-block: 30px; }
  .timeline { list-style: none; margin: 48px 0 0; padding: 0; border-left: 1px solid var(--color-border); }
  .timeline__item { position: relative; padding-left: 32px; padding-bottom: 48px; }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: -5px; top: 6px;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .timeline__meta { margin-bottom: 8px; }
  .timeline__range { font-size: var(--text-caption); text-transform: uppercase; letter-spacing: 1.5px; color: var(--color-text-muted); }
  .timeline__body { padding: 24px; }
  .timeline__property { color: var(--color-accent); font-size: var(--text-body); margin: 6px 0 12px; }
  .timeline__summary { color: var(--color-text-muted); }
  .timeline__highlights { margin-top: 16px; padding-left: 18px; color: var(--color-text-muted); font-size: var(--text-body); }
  .timeline__highlights li { margin-bottom: 6px; }
  .timeline__empty { color: var(--color-text-muted); margin-top: 32px; }
.eyebrow {
  color: var(--color-accent);
}
  @media (min-width: 768px) {
    .timeline { margin-left: 4px; }

   
     
     }

     @media (max-width: 768px) {
   

    .timeline__body { 
    overflow-y: scroll;
    height: 300px;
    scrollbar-width: auto;
     }
     
     }


      @media (max-width: 578px) {
.timeline__body { 
    overflow-y: scroll;
    height: 250px;
    scrollbar-width: none;
     }
      }
</style>
