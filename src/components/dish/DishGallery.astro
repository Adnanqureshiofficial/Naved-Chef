---
interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;
---

<section class="dish-gallery">

  <header class="dish-gallery__header">

    <div>
      <span class="dish-gallery__label">
        Details & process
      </span>

      <h2>
        Behind the creation
      </h2>
    </div>

    <span class="dish-gallery__count">
      {String(images.length).padStart(2, '0')} photographs
    </span>

  </header>

  <div class="dish-gallery__grid">

    {images.map((src, index) => (
      <figure
        class:list={[
          'dish-gallery__item',
          index === 0 && 'dish-gallery__item--large',
          index === 3 && 'dish-gallery__item--wide',
        ]}
      >

        <div class="dish-gallery__image-wrap">
          <img
            src={src}
            alt={`${title} — process detail ${index + 1}`}
            loading="lazy"
            decoding="async"
          />
        </div>

        <figcaption>
          {String(index + 1).padStart(2, '0')}
        </figcaption>

      </figure>
    ))}

  </div>

</section>

<style>
  .dish-gallery {
    width: min(100% - 3rem, 1400px);
    margin: 0 auto 10rem;
  }

  .dish-gallery__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;

    margin-bottom: 3rem;
  }

  .dish-gallery__label {
    display: block;
    margin-bottom: 0.8rem;

    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.55;
  }

  .dish-gallery h2 {
    margin: 0;

    font-family: var(--font-display, serif);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .dish-gallery__count {
    flex: 0 0 auto;

    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.5;
  }

  .dish-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .dish-gallery__item {
    margin: 0;
  }

  .dish-gallery__item--large {
    grid-row: span 2;
  }

  .dish-gallery__item--wide {
    grid-column: span 2;
  }

  .dish-gallery__image-wrap {
    overflow: hidden;
    background: #171411;
    border-radius: var(--radius-md, 0.75rem);
  }

  .dish-gallery__image-wrap img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;

    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .dish-gallery__item--large img {
    height: 100%;
    min-height: 600px;
  }

  .dish-gallery__item--wide img {
    aspect-ratio: 16 / 8;
  }

  .dish-gallery__item:hover img {
    transform: scale(1.035);
  }

  .dish-gallery__item figcaption {
    margin-top: 0.65rem;

    font-size: 0.65rem;
    letter-spacing: 0.1em;
    opacity: 0.45;
  }

  @media (max-width: 700px) {
    .dish-gallery {
      width: calc(100% - 2rem);
      margin-bottom: 6rem;
    }

    .dish-gallery__header {
      align-items: start;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .dish-gallery h2 {
      font-size: 2.8rem;
    }

    .dish-gallery__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .dish-gallery__item--large,
    .dish-gallery__item--wide {
      grid-column: auto;
      grid-row: auto;
    }

    .dish-gallery__item--large img,
    .dish-gallery__item--wide img {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dish-gallery__image-wrap img {
      transition: none;
    }
  }
</style>