<section class="contact" id="contact">
  <div class="container contact__inner">
    <p class="eyebrow">Get in Touch</p>
    <h2>Available for opportunities &amp; collaborations</h2>
    <div class="contact__actions">
      <a href="mailto:navedinamdar@gmail.com" class="contact__btn contact__btn--primary">Email Directly</a>
      <a href="/Shaikh_Naved CV.pdf" download="Naved Shaikh CV" class="contact__btn">Download Full CV (PDF)</a>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: 20px; text-align: center; border-top: 1px solid var(--color-border); }
  .contact__inner h2 { max-width: 20ch; margin-inline: auto; margin-top: 12px; }
  .contact__actions { display: flex; gap: 16px; justify-content: center; margin-top: 40px; flex-wrap: wrap; }
  .contact__btn {
    padding: 14px 28px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: border-color 0.3s var(--ease-luxury), color 0.3s var(--ease-luxury);
  }
  .contact__btn--primary { background: var(--color-accent); color: var(--color-bg); border-color: var(--color-accent); }
  .contact__btn:hover { border-color: var(--color-accent); color: var(--color-accent-hover); }
  .contact__btn--primary:hover { color: var(--color-bg); background: var(--color-accent-hover); }
</style>
