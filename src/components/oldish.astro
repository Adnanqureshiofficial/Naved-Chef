---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allDishes = await getCollection('dishes');
  return allDishes.map((dish) => ({
    params: { category: dish.data.category, dish: dish.id },
    props: { dish },
  }));
}

const { dish } = Astro.props;
const { Content } = await render(dish);

const categoryLabels: Record<string, string> = {
  'viennoiserie': 'Viennoiserie',
  'plated-dessert': 'Plated Art',
  'showpieces': 'Showpieces',
};
---
<BaseLayout
  title={`${dish.data.title} — ${categoryLabels[dish.data.category]}`}
  description={dish.data.flavorNote}
>
  <article class="dish">
    <div class="container">
      <a href={`/creations/${dish.data.category}`} class="dish__back">← {categoryLabels[dish.data.category]}</a>

      <div class="dish__hero card">
        <img src={dish.data.heroImage} alt={dish.data.title} />
      </div>

      <div class="dish__header">
        <p class="eyebrow">{categoryLabels[dish.data.category]}{dish.data.year ? ` · ${dish.data.year}` : ''}</p>
        <h1 class="font-display">{dish.data.title}</h1>
        <p class="dish__note">{dish.data.flavorNote}</p>
      </div>

      <div class="dish__body">
        <Content />
      </div>

      {dish.data.gallery.length > 0 && (
        <div class="dish__gallery">
          {dish.data.gallery.map((src) => (
            <div class="dish__gallery-image card">
              <img src={src} alt={`${dish.data.title} — process detail`} loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .dish { padding-top: 140px; padding-bottom: 100px; }
  .dish__back { color: var(--color-text-muted); font-size: var(--text-caption); text-transform: uppercase; letter-spacing: 1.5px; }
  .dish__hero { aspect-ratio: 16/9; background: var(--color-surface); margin-top: 24px; overflow: hidden; }
  .dish__hero img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
  .dish__header { margin-top: 32px; max-width: 60ch; }
  .dish__header h1 { font-size: var(--text-display); margin-top: 12px; }
  .dish__note { color: var(--color-text-muted); font-size: var(--text-body-lg); margin-top: 16px; }
  .dish__body { max-width: 60ch; margin-top: 32px; color: var(--color-text-muted); font-size: var(--text-body-lg); }
  .dish__gallery { display: grid; gap: 16px; margin-top: 48px; grid-template-columns: repeat(2, 1fr); }
  .dish__gallery-image { aspect-ratio: 4/3; background: var(--color-surface); overflow: hidden; }
  .dish__gallery-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
</style>
