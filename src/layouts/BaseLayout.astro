---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Pastry portfolio and career profile."
} = Astro.props;
---

<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

  </head>


  <body>

    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <header
      class="site-nav"
      id="site-nav"
    >

      <div class="container site-nav__inner">

        <!-- =================================================
             BRAND
             ================================================= -->

        <a
          href="/"
          class="site-nav__logo"
          aria-label="Chef Naved — Home"
        >
          CHEF DE PARTIE
        </a>


        <!-- =================================================
             DESKTOP NAVIGATION
             ================================================= -->

        <nav
          class="site-nav__links"
          aria-label="Primary navigation"
        >

          <a
            href="/creations"
            class="site-nav__link"
          >
            Portfolio
          </a>


          <a
            href="/Shaikh_Naved CV.pdf"
            class="site-nav__cta"
          >
            <span>Download CV</span>

            <span
              class="site-nav__cta-arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>

        </nav>


        <!-- =================================================
             MOBILE MENU BUTTON
             ================================================= -->

        <button
          class="site-nav__menu"
          id="site-nav-menu"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >

          <span></span>
          <span></span>

        </button>

      </div>


      <!-- ===================================================
           MOBILE FULL-SCREEN NAVIGATION
           =================================================== -->

      <nav
        id="mobile-navigation"
        class="site-nav__mobile"
        aria-label="Mobile navigation"
        aria-hidden="true"
      >

        <div class="site-nav__mobile-inner">


          <!-- ===============================================
               MOBILE MENU HEADING
               =============================================== -->

          <div class="site-nav__mobile-heading">

            <span>
              Navigation
            </span>

            <span>
              Pastry &amp; Bakery
            </span>

          </div>


          <!-- ===============================================
               MOBILE LINKS
               =============================================== -->

          <div class="site-nav__mobile-links">


            <!-- HOME -->

            <a
              href="/"
              class="site-nav__mobile-link"
            >

              <span
                class="site-nav__mobile-number"
              >
                01
              </span>

              <span
                class="site-nav__mobile-label"
              >
                Home
              </span>

              <span
                class="site-nav__mobile-arrow"
                aria-hidden="true"
              >
                ↗
              </span>

            </a>


            <!-- PORTFOLIO -->

            <a
              href="/creations"
              class="site-nav__mobile-link"
            >

              <span
                class="site-nav__mobile-number"
              >
                02
              </span>

              <span
                class="site-nav__mobile-label"
              >
                Portfolio
              </span>

              <span
                class="site-nav__mobile-arrow"
                aria-hidden="true"
              >
                ↗
              </span>

            </a>


            <!-- CV -->

            <a
              href="/Shaikh_Naved CV.pdf" download="Naved Shaikh - CDP"
              class="site-nav__mobile-link site-nav__mobile-link--cv"
            >

              <span
                class="site-nav__mobile-number"
              >
                03
              </span>

              <span
                class="site-nav__mobile-label"
              >
                View CV
              </span>

              <span
                class="site-nav__mobile-arrow"
                aria-hidden="true"
              >
                ↗
              </span>

            </a>

          </div>


          <!-- ===============================================
               MOBILE FOOTER
               =============================================== -->

          <div class="site-nav__mobile-footer">

            <span>
              Chef de Partie
            </span>

            <span>
              Pastry &amp; Bakery
            </span>

          </div>

        </div>

      </nav>

    </header>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main>
      <slot />
    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="site-footer">

      <div class="container site-footer__inner">

        <p class="eyebrow">
          Chef de Partie – Pastry, Taj Hotels
        </p>


        <p class="site-footer__contact">

          <a href="mailto:navedinamdar@gmail.com">
            navedinamdar@gmail.com
          </a>
        
          <span aria-hidden="true">
            ·
          </span>

          <a href="tel:+919860027280">
            +91 98600 27280
          </a>

        </p>


        <p class="site-footer__copyright">
          &copy; {new Date().getFullYear()}. All rights reserved.
        </p>

      </div>

    </footer>


    <!-- =====================================================
         NAVIGATION SCRIPT
         ===================================================== -->

    <script>

      const siteNav =
        document.getElementById("site-nav");

      const menuButton =
        document.getElementById("site-nav-menu");

      const mobileNav =
        document.getElementById("mobile-navigation");


      if (
        siteNav &&
        menuButton &&
        mobileNav
      ) {


        /* ===================================================
           SCROLL STATE
           =================================================== */

        const updateNavbar = () => {

          const scrollY =
            window.scrollY;


          siteNav.classList.toggle(
            "is-scrolled",
            scrollY > 24
          );

        };


        /*
         * Run once immediately.
         */

        updateNavbar();


        /*
         * Passive listener keeps scrolling performant.
         */

        window.addEventListener(
          "scroll",
          updateNavbar,
          {
            passive: true
          }
        );


        /* ===================================================
           OPEN MENU
           =================================================== */

        const openMenu = () => {

          siteNav.classList.add(
            "menu-open"
          );


          menuButton.setAttribute(
            "aria-expanded",
            "true"
          );


          menuButton.setAttribute(
            "aria-label",
            "Close navigation"
          );


          mobileNav.setAttribute(
            "aria-hidden",
            "false"
          );


          document.body.classList.add(
            "menu-open"
          );

        };


        /* ===================================================
           CLOSE MENU
           =================================================== */

        const closeMenu = () => {

          siteNav.classList.remove(
            "menu-open"
          );


          menuButton.setAttribute(
            "aria-expanded",
            "false"
          );


          menuButton.setAttribute(
            "aria-label",
            "Open navigation"
          );


          mobileNav.setAttribute(
            "aria-hidden",
            "true"
          );


          document.body.classList.remove(
            "menu-open"
          );

        };


        /* ===================================================
           MENU TOGGLE
           =================================================== */

        menuButton.addEventListener(
          "click",
          () => {

            const isOpen =
              menuButton.getAttribute(
                "aria-expanded"
              ) === "true";


            if (isOpen) {

              closeMenu();

            } else {

              openMenu();

            }

          }
        );


        /* ===================================================
           CLOSE AFTER LINK CLICK
           =================================================== */

        mobileNav
          .querySelectorAll("a")
          .forEach((link) => {

            link.addEventListener(
              "click",
              closeMenu
            );

          });


        /* ===================================================
           ESCAPE KEY
           =================================================== */

        document.addEventListener(
          "keydown",
          (event) => {

            if (
              event.key === "Escape" &&
              menuButton.getAttribute(
                "aria-expanded"
              ) === "true"
            ) {

              closeMenu();

            }

          }
        );


        /* ===================================================
           RESET MENU WHEN RETURNING TO DESKTOP
           =================================================== */

        window.addEventListener(
          "resize",
          () => {

            if (
              window.innerWidth > 768 &&
              menuButton.getAttribute(
                "aria-expanded"
              ) === "true"
            ) {

              closeMenu();

            }

          }
        );

      }

    </script>


    <!-- =====================================================
         STYLES
         ===================================================== -->

    <style>


      /* =====================================================
         NAVIGATION
         ===================================================== */

      .site-nav {

        position: fixed;

        inset: 0 0 auto 0;

        z-index: 100;

        width: 100%;
        height: 70px;

        display: flex;
        align-items: center;

        background: transparent;

        border-bottom:
          1px solid transparent;

        color:
          var(--color-text);

        transition:
          background-color 0.45s var(--ease-luxury),
          border-color 0.45s var(--ease-luxury),
          box-shadow 0.45s var(--ease-luxury),
          backdrop-filter 0.45s var(--ease-luxury);

        isolation: isolate;

      }


      /* =====================================================
         SCROLLED NAVIGATION
         ===================================================== */

      .site-nav.is-scrolled {

        background:
          rgba(20, 18, 16, 0.82);

        border-bottom:
          1px solid
          rgba(249, 246, 240, 0.08);

        backdrop-filter:
          blur(14px);

        -webkit-backdrop-filter:
          blur(14px);

        box-shadow:
          0 8px 30px
          rgba(0, 0, 0, 0.08);

      }


      /* =====================================================
         NAV INNER
         ===================================================== */

      .site-nav__inner {

        width: 100%;
        min-width: 0;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 24px;

      }


      /* =====================================================
         LOGO
         ===================================================== */

      .site-nav__logo {

        display: inline-flex;

        align-items: center;

        flex-shrink: 0;

        color:
          var(--color-text);

        font-family:
          var(--font-display);

        font-size: 26px;

        font-weight: 400;

        line-height: 1;

        letter-spacing:
          0.025em;

        white-space: nowrap;

        text-decoration: none;

        transition:
          color 0.35s var(--ease-luxury);

      }


      .site-nav__logo:hover {

        color:
          var(--color-accent-hover);

      }


      /* =====================================================
         DESKTOP NAVIGATION
         ===================================================== */

      .site-nav__links {

        display: flex;

        align-items: center;

        gap: 18px;

        flex-shrink: 0;

      }


      /* =====================================================
         PORTFOLIO LINK
         ===================================================== */

      .site-nav__link {

        position: relative;

        display: inline-flex;

        align-items: center;

        min-height: 40px;

        padding-inline: 12px;

        color:
          rgba(249, 246, 240, 0.82);

        font-family:
          var(--font-body);

        font-size: 10px;

        font-weight: 500;

        line-height: 1;

        letter-spacing: 1.5px;

        text-transform: uppercase;

        text-decoration: none;

        white-space: nowrap;

        transition:
          color 0.3s var(--ease-luxury);

      }


      .site-nav__link::after {

        content: "";

        position: absolute;

        left: 12px;
        right: 12px;

        bottom: 7px;

        height: 1px;

        background:
          var(--color-accent);

        transform:
          scaleX(0);

        transform-origin: right;

        transition:
          transform 0.4s var(--ease-luxury);

      }


      .site-nav__link:hover {

        color:
          var(--color-text);

      }


      .site-nav__link:hover::after {

        transform:
          scaleX(1);

        transform-origin: left;

      }


      /* =====================================================
         CV BUTTON
         ===================================================== */

      .site-nav__cta {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        min-height: 36px;

        padding-inline: 15px;

        background:
          var(--color-accent);

        border:
          1px solid
          var(--color-accent);

        border-radius: 2px;

        color:
          #141210;

        font-family:
          var(--font-body);

        font-size: 9px;

        font-weight: 600;

        line-height: 1;

        letter-spacing: 1.4px;

        text-transform: uppercase;

        text-decoration: none;

        white-space: nowrap;

        transition:
          background-color 0.3s var(--ease-luxury),
          border-color 0.3s var(--ease-luxury),
          transform 0.3s var(--ease-luxury),
          box-shadow 0.3s var(--ease-luxury);

      }


      .site-nav__cta-arrow {

        font-size: 13px;

        line-height: 1;

        transition:
          transform 0.3s var(--ease-luxury);

      }


      .site-nav__cta:hover {

        background:
          var(--color-accent-hover);

        border-color:
          var(--color-accent-hover);

        transform:
          translateY(-1px);

        box-shadow:
          0 6px 20px
          rgba(200, 169, 107, 0.16);

      }


      .site-nav__cta:hover
      .site-nav__cta-arrow {

        transform:
          translate(2px, -2px);

      }


      /* =====================================================
         MOBILE MENU BUTTON
         ===================================================== */

      .site-nav__menu {

        display: none;

        position: relative;

        width: 42px;
        height: 42px;

        flex-shrink: 0;

        align-items: center;

        justify-content: center;

        padding: 0;

        border:
          1px solid
          rgba(249, 246, 240, 0.22);

        border-radius: 2px;

        background:
          rgba(20, 18, 16, 0.12);

        cursor: pointer;

        transition:
          background-color 0.3s var(--ease-luxury),
          border-color 0.3s var(--ease-luxury);

      }


      .site-nav__menu:hover {

        border-color:
          var(--color-accent);

        background:
          rgba(200, 169, 107, 0.08);

      }


      .site-nav__menu span {

        position: absolute;

        right: 10px;

        width: 19px;
        height: 1px;

        background:
          var(--color-text);

        transform-origin: center;

        transition:
          transform 0.4s var(--ease-luxury),
          opacity 0.25s var(--ease-luxury),
          background-color 0.3s var(--ease-luxury);

      }


      .site-nav__menu span:first-child {

        top: 16px;

      }


      .site-nav__menu span:last-child {

        top: 24px;

        width: 13px;

      }


      /* =====================================================
         HAMBURGER → X
         ===================================================== */

      .site-nav__menu[aria-expanded="true"]
      span:first-child {

        top: 20px;

        width: 21px;

        transform:
          rotate(45deg);

      }


      .site-nav__menu[aria-expanded="true"]
      span:last-child {

        top: 20px;

        width: 21px;

        transform:
          rotate(-45deg);

      }


      /* =====================================================
         MOBILE NAVIGATION
         ===================================================== */

      .site-nav__mobile {

        display: none;

      }


      /* =====================================================
         TABLET + MOBILE
         ===================================================== */

      @media (max-width: 768px) {


        .site-nav {

          height: 70px;

        }


        /* Hide desktop navigation */

        .site-nav__links {

          display: none;

        }


        /* Show hamburger */

        .site-nav__menu {

          display: flex;

          z-index: 102;

        }


        /* =================================================
           FULL SCREEN MENU
           ================================================= */

        .site-nav__mobile {

          position: fixed;

          inset: 0;

          z-index: 101;

          display: block;

          width: 100%;

          height: 100svh;

          min-height: 100vh;

          box-sizing: border-box;

          background:
            var(--color-accent);

          color:
            #141210;

          opacity: 0;

          visibility: hidden;

          pointer-events: none;

          transform:
            translateY(-10px);

          transition:
            opacity 0.35s var(--ease-luxury),
            transform 0.5s var(--ease-luxury),
            visibility 0.35s;

        }


        /* Open state */

        .site-nav.menu-open .site-nav__mobile {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
}

        /* =================================================
           NAVBAR WHEN MENU IS OPEN
           ================================================= */

        .site-nav.menu-open {

          background:
            var(--color-accent);

          border-bottom:
            1px solid
            rgba(20, 18, 16, 0.12);

        }


        .site-nav.menu-open
        .site-nav__logo {

          color:
            #141210;

        }


        .site-nav.menu-open
        .site-nav__menu {

          border-color:
            rgba(20, 18, 16, 0.28);

          background:
            rgba(20, 18, 16, 0.06);

        }


        .site-nav.menu-open
        .site-nav__menu span {

          background:
            #141210;

        }


        /* =================================================
           MOBILE INNER
           ================================================= */

        .site-nav__mobile-inner {

          width: 100%;

          height: 100%;

          display: flex;

          flex-direction: column;

          box-sizing: border-box;

          padding:
            94px
            clamp(20px, 6vw, 48px)
            28px;

        }


        /* =================================================
           MOBILE HEADING
           ================================================= */

        .site-nav__mobile-heading {

          display: flex;

          align-items: center;

          justify-content: space-between;

          padding-bottom: 16px;

          border-bottom:
            1px solid
            rgba(20, 18, 16, 0.2);

          color:
            rgba(20, 18, 16, 0.68);

          font-family:
            var(--font-body);

          font-size: 9px;

          font-weight: 600;

          letter-spacing: 1.6px;

          line-height: 1;

          text-transform: uppercase;

        }


        /* =================================================
           MOBILE LINKS
           ================================================= */

        .site-nav__mobile-links {

          display: flex;

          flex-direction: column;

          margin-top:
            clamp(32px, 7vh, 64px);

        }


        .site-nav__mobile-link {

          display: grid;

          grid-template-columns:
            36px 1fr 24px;

          align-items: center;

          width: 100%;

          min-height:
            clamp(72px, 12vh, 104px);

          border-bottom:
            1px solid
            rgba(20, 18, 16, 0.18);

          color:
            #141210;

          font-family:
            var(--font-display);

          font-size:
            clamp(36px, 6vw, 58px);

          font-weight: 400;

          line-height: 0.95;

          letter-spacing:
            -0.025em;

          text-decoration: none;

          transition:
            padding-left 0.4s var(--ease-luxury),
            opacity 0.3s ease;

        }


        /* Number */

        .site-nav__mobile-number {

          color:
            rgba(20, 18, 16, 0.48);

          font-family:
            var(--font-body);

          font-size: 9px;

          font-weight: 600;

          letter-spacing: 1.3px;

        }


        /* Arrow */

        .site-nav__mobile-arrow {

          justify-self: end;

          color:
            rgba(20, 18, 16, 0.5);

          font-family:
            var(--font-body);

          font-size: 17px;

          transition:
            transform 0.4s var(--ease-luxury),
            color 0.3s ease;

        }


        .site-nav__mobile-link:hover {

          padding-left: 8px;

        }


        .site-nav__mobile-link:hover
        .site-nav__mobile-arrow {

          color:
            #141210;

          transform:
            translate(3px, -3px);

        }


        /* =================================================
           CV LINK
           ================================================= */

        .site-nav__mobile-link--cv {

          margin-top:
            clamp(22px, 4vh, 34px);

          min-height:
            clamp(62px, 9vh, 76px);

          padding-inline: 16px;

          border:
            1px solid
            #141210;

          background:
            #141210;

          color:
            var(--color-accent);

          font-family:
            var(--font-body);

          font-size:
            clamp(11px, 3vw, 14px);

          font-weight: 600;

          letter-spacing: 1.8px;

          text-transform: uppercase;

          transition:
            background-color 0.3s var(--ease-luxury),
            color 0.3s var(--ease-luxury),
            transform 0.3s var(--ease-luxury);

        }


        .site-nav__mobile-link--cv
        .site-nav__mobile-number {

          color:
            rgba(200, 169, 107, 0.55);

        }


        .site-nav__mobile-link--cv:hover {

          padding-left: 16px;

          background:
            transparent;

          color:
            #141210;

          transform:
            translateY(-1px);

        }


        /* =================================================
           MOBILE FOOTER
           ================================================= */

        .site-nav__mobile-footer {

          display: flex;

          align-items: center;

          justify-content: space-between;

          gap: 20px;

          margin-top: auto;

          padding-top: 18px;

          border-top:
            1px solid
            rgba(20, 18, 16, 0.2);

          color:
            rgba(20, 18, 16, 0.58);

          font-family:
            var(--font-body);

          font-size: 8px;

          font-weight: 600;

          letter-spacing: 1.3px;

          text-transform: uppercase;

        }

      }


      /* =====================================================
         SMALL PHONES
         ===================================================== */

      @media (max-width: 480px) {

        .site-nav {

          height: 64px;

        }


        .site-nav__logo {

          font-size:
            clamp(21px, 6vw, 25px);

          letter-spacing:
            0.02em;

        }


        .site-nav__menu {

          width: 40px;

          height: 40px;

        }


        .site-nav__mobile-inner {

          padding:
            84px
            20px
            24px;

        }


        .site-nav__mobile-link {

          grid-template-columns:
            32px 1fr 20px;

          min-height:
            74px;

          font-size:
            clamp(20px, 5vw, 44px);

        }


        .site-nav__mobile-number {

          font-size: 8px;

        }


        .site-nav__mobile-arrow {

          font-size: 15px;

        }


        .site-nav__mobile-link--cv {

          min-height: 60px;

          font-size: 11px;

          letter-spacing: 1.5px;

        }

      }


      /* =====================================================
         VERY SMALL PHONES
         ===================================================== */

      @media (max-width: 360px) {

        .site-nav {

          height: 62px;

        }


        .site-nav__logo {

          font-size: 21px;

        }


        .site-nav__menu {

          width: 38px;

          height: 38px;

        }


        .site-nav__mobile-inner {

          padding:
            80px
            18px
            22px;

        }


        .site-nav__mobile-link {

          min-height: 68px;

          font-size: 20px;

        }


        .site-nav__mobile-links {

          margin-top: 28px;

        }


        .site-nav__mobile-link--cv {

          min-height: 56px;

          margin-top: 20px;

          font-size: 10px;

        }

      }


      /* =====================================================
         ACCESSIBILITY
         ===================================================== */

      .site-nav a:focus-visible,
      .site-nav button:focus-visible {

        outline:
          2px solid
          var(--color-accent);

        outline-offset: 4px;

      }


      .site-nav.menu-open
      a:focus-visible,
      .site-nav.menu-open
      button:focus-visible {

        outline-color:
          #141210;

      }


      /* =====================================================
         BODY LOCK
         ===================================================== */

      :global(body.menu-open) {

        overflow: hidden;

      }


      /* =====================================================
         REDUCED MOTION
         ===================================================== */

      @media (prefers-reduced-motion: reduce) {

        .site-nav,
        .site-nav *,
        .site-nav__mobile {

          transition: none !important;

        }

      }


      /* =====================================================
         FOOTER
         ===================================================== */

      .site-footer {

        border-top:
          1px solid
          var(--color-border);

        padding-block: 48px;

        margin-top: 120px;

      }


