---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Pastry portfolio and career profile." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <noscript>
  <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
</noscript>
  </head>
  <body>
 <header class="site-nav">
  <div class="container site-nav__inner">

    <a href="/" class="site-nav__logo" aria-label="Chef Portfolio">
      CHEF NAVED
    </a>

    <!-- Desktop navigation -->
    <nav class="site-nav__links" aria-label="Primary navigation">
      <a href="/" class="site-nav__link">Portfolio</a>
      <a href="/cv/" class="site-nav__cta">Download CV</a>
    </nav>

    <!-- Mobile menu button -->
    <button
      class="site-nav__menu"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- Mobile navigation -->
  <nav
    id="mobile-navigation"
    class="site-nav__mobile"
    aria-label="Mobile navigation"
  >
    <div class="site-nav__mobile-inner">

      <a href="/" class="site-nav__mobile-link">
        <span>01</span>
        Portfolio
      </a>

      <a href="/cv/" class="site-nav__mobile-link site-nav__mobile-link--cta">
        <span>02</span>
        View CV
      </a>

    </div>
  </nav>
</header>


    <main class="">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="eyebrow">Chef de Partie – Pastry, Taj Hotels</p>
        <p class="site-footer__contact">
          <a href="mailto:chef@example.com">chef@example.com</a> ·
          <a href="tel:+919860027280">+91 98600 27280</a>
        </p>
        <p class="site-footer__copyright">&copy; {new Date().getFullYear()}. All rights reserved.</p>
      </div>
    </footer>
<script>


  const menuButton = document.querySelector('.site-nav__menu');
  const mobileNav = document.querySelector('.site-nav__mobile');

  if (menuButton && mobileNav) {
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';

      menuButton.setAttribute(
        'aria-expanded',
        String(!isOpen)
      );

      mobileNav.classList.toggle('is-open', !isOpen);

      document.body.classList.toggle(
        'menu-open',
        !isOpen
      );
    });

    /*
     * Close mobile navigation after selecting a link.
     */
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuButton.setAttribute(
          'aria-expanded',
          'false'
        );

        mobileNav.classList.remove('is-open');

        document.body.classList.remove(
          'menu-open'
        );
      });
    });
  }

</script>
  <style>

    /* =========================================================
   NAVIGATION
   ========================================================= */

.site-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;

  z-index: 100;

  width: 100%;
  height: 70px;

  display: flex;
  align-items: center;

  /*
   * Transparent luxury navigation.
   * The hero remains visible behind it.
   */
  background: transparent;


 
  border-bottom: 1px solid rgba(212, 175, 55, 0.06);
}


/* =========================================================
   NAV INNER
   ========================================================= */

.site-nav__inner {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;
}


/* =========================================================
   CHEF / LOGO
   ========================================================= */

.site-nav__logo {
  display: inline-flex;
  align-items: center;

  flex-shrink: 0;

  color: var(--color-text);

  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: 1px;

  white-space: nowrap;

  transition:
    color 0.35s var(--ease-luxury);
}


.site-nav__logo:hover {
  color: var(--color-accent-hover);
}


/* =========================================================
   DESKTOP NAVIGATION
   ========================================================= */

.site-nav__links {
  display: flex;
  align-items: center;

  gap: 14px;

  flex-shrink: 0;

  font-family: var(--font-body);
  font-size: var(--text-caption);
  font-weight: 400;

  text-transform: uppercase;
  letter-spacing: 1.6px;
}


/* =========================================================
   PORTFOLIO LINK
   ========================================================= */

.site-nav__link {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 40px;

  padding: 0 14px;

  color: var(--color-text);

  white-space: nowrap;

  transition:
    color 0.3s var(--ease-luxury);
}


/*
 * Elegant gold underline.
 */
.site-nav__link::after {
  content: "";

  position: absolute;

  left: 14px;
  right: 14px;
  bottom: 5px;

  height: 1px;

  background: var(--color-accent);

  transform: scaleX(0);
  transform-origin: center;

  transition:
    transform 0.35s var(--ease-luxury);
}


.site-nav__link:hover {
  color: var(--color-accent-hover);
}


.site-nav__link:hover::after {
  transform: scaleX(1);
}


/* =========================================================
   CV BUTTON
   ========================================================= */

.site-nav__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 40px;

  padding: 0 19px;

  border: 1px solid var(--color-accent);
  border-radius: 3px;

  /*
   * Gold CTA as requested.
   */
  background: var(--color-accent);

  color: #141210;

  font-family: var(--font-body);
  font-size: var(--text-caption);
  font-weight: 500;

  text-transform: uppercase;
  letter-spacing: 1.6px;

  white-space: nowrap;

  box-shadow:
    0 4px 18px rgba(212, 175, 55, 0.08);

  transition:
    background 0.3s var(--ease-luxury),
    border-color 0.3s var(--ease-luxury),
    color 0.3s var(--ease-luxury),
    transform 0.3s var(--ease-luxury),
    box-shadow 0.3s var(--ease-luxury);
}


.site-nav__cta:hover {
  background: var(--color-accent-hover);

  border-color: var(--color-accent-hover);

  color: #141210;

  transform: translateY(-1px);

  box-shadow:
    0 7px 24px rgba(212, 175, 55, 0.16);
}


.site-nav__cta:active {
  transform: translateY(0);
}


/* =========================================================
   MOBILE MENU BUTTON
   ========================================================= */

/*
 * Hidden on desktop.
 */
.site-nav__menu {
  display: none;

  position: relative;

  width: 42px;
  height: 42px;

  flex-shrink: 0;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  gap: 6px;

  padding: 0;

  border: 1px solid rgba(212, 175, 55, 0.28);
  border-radius: 3px;

  background: rgba(20, 18, 16, 0.08);

  color: var(--color-text);

  cursor: pointer;

  transition:
    border-color 0.3s var(--ease-luxury),
    background 0.3s var(--ease-luxury);
}


.site-nav__menu:hover {
  border-color: var(--color-accent);

  background: rgba(212, 175, 55, 0.08);
}


.site-nav__menu span {
  display: block;

  width: 17px;
  height: 1px;

  background: var(--color-text);

  transform-origin: center;

  transition:
    transform 0.35s var(--ease-luxury),
    opacity 0.25s var(--ease-luxury);
}


/* =========================================================
   HAMBURGER → X
   ========================================================= */

.site-nav__menu[aria-expanded="true"] span:first-child {
  transform: translateY(3.5px) rotate(45deg);
}


.site-nav__menu[aria-expanded="true"] span:last-child {
  transform: translateY(-3.5px) rotate(-45deg);
}


/* =========================================================
   MOBILE NAVIGATION
   ========================================================= */

/*
 * Completely hidden on desktop.
 *
 * This prevents the mobile links from accidentally appearing
 * underneath the desktop navbar.
 */
.site-nav__mobile {
  display: none;
}


/* =========================================================
   TABLET + MOBILE
   ========================================================= */

@media (max-width: 768px) {

  .site-nav {
    height: 70px;

  
  }


  /*
   * Remove desktop navigation.
   */
  .site-nav__links {
    display: none;
  }


  /*
   * Show hamburger.
   */
  .site-nav__menu {
    display: flex;
  }


  /*
   * Mobile navigation panel.
   */
  .site-nav__mobile {
    position: fixed;

    top: 70px;
    left: 0;
    right: 0;

    z-index: 99;

    display: block;

    width: 100%;

    background: rgba(20, 18, 16, 0.90);

    border-bottom: 1px solid var(--color-border);

  
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-10px);

    transition:
      opacity 0.35s var(--ease-luxury),
      transform 0.35s var(--ease-luxury),
      visibility 0.35s var(--ease-luxury);
  }


  /*
   * Open state.
   */
  .site-nav__mobile.is-open {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform: translateY(0);
  }


  .site-nav__mobile-inner {
    display: flex;

    flex-direction: column;

    width: 100%;

    padding:
      8px
      clamp(20px, 5vw, 64px)
      20px;
  }


  /* =======================================================
     MOBILE LINKS
     ======================================================= */

  .site-nav__mobile-link {
    display: grid;

    grid-template-columns: 42px 1fr;

    align-items: center;

    width: 100%;

    min-height: 64px;

    border-bottom: 1px solid rgba(212, 175, 55, 0.10);

    color: var(--color-text-muted);

    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 400;

    transition:
      color 0.3s var(--ease-luxury),
      padding-left 0.3s var(--ease-luxury);
  }


  .site-nav__mobile-link span {
    color: var(--color-accent);

    font-family: var(--font-body);

    font-size: 10px;
    font-weight: 400;

    letter-spacing: 1.5px;
  }


  .site-nav__mobile-link:hover {
    color: var(--color-text);

    padding-left: 5px;
  }


  /* =======================================================
     MOBILE CV BUTTON
     ======================================================= */

  .site-nav__mobile-link--cta {
    display: grid;

    grid-template-columns: 42px 1fr;

    align-items: center;

    min-height: 56px;

    margin-top: 12px;

    padding: 0 16px;

    border: 1px solid var(--color-accent);

    border-radius: 3px;

    background: var(--color-accent);

    color: #141210;

    font-family: var(--font-body);

    font-size: 12px;
    font-weight: 500;

    text-transform: uppercase;

    letter-spacing: 1.6px;

    transition:
      background 0.3s var(--ease-luxury),
      border-color 0.3s var(--ease-luxury),
      transform 0.3s var(--ease-luxury);
  }


  .site-nav__mobile-link--cta span {
    color: rgba(20, 18, 16, 0.60);
  }


  .site-nav__mobile-link--cta:hover {
    padding-left: 16px;

    background: var(--color-accent-hover);

    border-color: var(--color-accent-hover);

    color: #141210;

    transform: translateY(-1px);
  }
}


/* =========================================================
   SMALL PHONES
   ========================================================= */

@media (max-width: 480px) {

  .site-nav {
    height: 64px;
  }


  .site-nav__mobile {
    top: 64px;
  }


  .site-nav__logo {
    font-size: 25px;
  }


  .site-nav__menu {
    width: 40px;
    height: 40px;
  }


  .site-nav__mobile-inner {
    padding-inline: 16px;
  }


  .site-nav__mobile-link {
    min-height: 60px;

    font-size: 25px;
  }
}


/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-width: 360px) {

  .site-nav {
    height: 62px;
  }


  .site-nav__mobile {
    top: 62px;
  }


  .site-nav__logo {
    font-size: 23px;
  }


  .site-nav__menu {
    width: 38px;
    height: 38px;
  }
}


/* =========================================================
   PAGE OFFSET
   ========================================================= */

/*
 * Because the navbar is fixed, page content needs to start
 * below it.
 */

:global(.page-main) {
  padding-top: 70px;
}


@media (max-width: 480px) {

  :global(.page-main) {
    padding-top: 64px;
  }
}


@media (max-width: 360px) {

  :global(.page-main) {
    padding-top: 62px;
  }
}


/* =========================================================
   BODY LOCK
   ========================================================= */

:global(body.menu-open) {
  overflow: hidden;
}


/* =========================================================
   FOOTER
   ========================================================= */

.site-footer {
  border-top: 1px solid var(--color-border);

  padding-block: 48px;

  margin-top: 120px;
}


.site-footer__contact {
  margin-block: 12px;

  color: var(--color-text-muted);
}


.site-footer__contact a {
  transition:
    color 0.3s var(--ease-luxury);
}


.site-footer__contact a:hover {
  color: var(--color-accent);
}


.site-footer__copyright {
  color: var(--color-text-muted);

  font-size: var(--text-caption);
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .site-nav *,
  .site-nav__mobile {
    transition: none !important;
  }
}
  </style>
  </body>

  
</html>
